# 生产环境配置（docker compose 使用）。复制为 .env 后填写。

# 数据库密码：随机字符串，例如 openssl rand -hex 16 的结果
DB_PASSWORD=

# 登录令牌密钥：随机长字符串，例如 openssl rand -hex 32 的结果。泄露后请更换（所有人需重新登录）
AUTH_SECRET=

# 初始教师账号（仅首次执行 seed 时使用，首次登录会要求改密码）
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123

# 用 https 访问时改为 true；用 http://IP 访问时必须是 false
COOKIE_SECURE=false

# 对外端口
APP_PORT=80

# 部署在 Caddy/Nginx 反向代理后面时改为 true（登录限流按真实 IP 计算）
TRUST_PROXY=false
